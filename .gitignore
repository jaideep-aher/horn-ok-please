# Unblurred photographs. Rebuild with eval/photos/fetch_sources.py
# and eval/round2/build_stimuli.py. Do not commit them.
eval/photos/source/images/
eval/photos/stimuli/**/*.jpg
eval/photos/stimuli/**/*.jpeg
eval/photos/stimuli/**/*.png
eval/round2/stimuli/clean/photo_*.png
eval/round3/stimuli/clean/photo_*.png

# Phase-2 Western control. Committed frames are drawn PNGs, not photographs.
# eval/gemini_remote/phase2/us_trucks/ holds those dry-van frames.
# Builder scratch stays local.
eval/gemini_remote/phase2/us_trucks/**/*.webp
eval/gemini_remote/phase2/us_trucks/**/*.tmp
eval/gemini_remote/phase2/**/__pycache__/
